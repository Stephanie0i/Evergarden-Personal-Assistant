            {
              "id": "2e690dae-db86-426b-93ad-4acb6f8c769f",
              "leftValue": "={{ $now.format('HH:mm') }}",
              "rightValue": "={{ $json.remind_time }}",
              "operator": {
                "type": "string",
                "operation": "equals",
                "name": "filter.operator.equals"
              }
            },
            {
              "id": "bba8857c-c63c-4237-9d0c-64f0662b3074",
              "leftValue": "=={{ $json.type === 'daily' ? true : ($json.type === 'monthly' ? ($now.format('D') === String($json.remind_date)) : ($now.format('YYYY-MM-DD') === $json.remind_date)) }}",
              "rightValue": "true",
              "operator": {
                "type": "string",
                "operation": "equals",
                "name": "filter.operator.equals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
